# Supabase (Project Settings -> API in your Supabase dashboard)
# Use the "service_role" key, not the "anon" key — it's only ever used
# server-side (Route Handlers), never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel login (choose your own values)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Resend (resend.com) — sends an email the moment a lead is captured in the chat.
# API key from the Resend dashboard.
RESEND_API_KEY=
# The inbox that should receive new-lead emails (your own address).
LEAD_NOTIFICATION_EMAIL=
# Optional. Defaults to Resend's shared "onboarding@resend.dev" sender, which
# only delivers to the account's own verified email. Once you verify a domain
# in Resend, set this to something like "יעקב-אליה <leads@yourdomain.com>"
# so it can email any address.
RESEND_FROM_EMAIL=
