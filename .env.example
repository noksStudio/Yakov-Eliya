# Supabase (the project's "Connect" screen in your Supabase dashboard)
# Use the secret key (sb_secret_…), not the publishable one — it's only ever
# used server-side (Route Handlers), never sent to the browser.
# The legacy service_role key also works, as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Admin panel login (choose your own values)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Resend (resend.com) — sends an email the moment a lead is captured in the chat.
# API key from the Resend dashboard.
RESEND_API_KEY=
# The inbox that should receive new-lead emails (your own address).
LEAD_NOTIFICATION_EMAIL=
# Optional. Defaults to Resend's shared "onboarding@resend.dev" sender, which
# only delivers to the account's own verified email. Once you verify a domain
# in Resend, set this to something like "יעקב-אליה <leads@yourdomain.com>"
# so it can email any address.
RESEND_FROM_EMAIL=

# Personal life OS (/life) — the "chief manager" agent runs on Claude.
# Create a key at console.anthropic.com -> API Keys (and set a monthly spend limit there).
# The /life tables are created by running supabase/life.sql in the Supabase SQL editor.
ANTHROPIC_API_KEY=

# Telegram bot for /life notifications and quick logging. Create a bot with @BotFather
# (/newbot) and paste its token here. Everything else (webhook, linking your chat, the
# notification schedule) is done from /life/settings.
TELEGRAM_BOT_TOKEN=
